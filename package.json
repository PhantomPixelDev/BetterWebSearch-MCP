{
  "name": "better-web-search-mcp",
  "version": "0.1.0",
  "description": "MCP server for genuinely better web research — keyless-first (DuckDuckGo), 3-tier extraction, deep research. Brave/Tavily optional.",
  "type": "module",
  "bin": {
    "better-web-search-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "mcp.json",
    "smithery.yaml",
    ".vscode/mcp.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PhantomPixelDev/BetterWebSearch-MCP.git"
  },
  "homepage": "https://github.com/PhantomPixelDev/BetterWebSearch-MCP#readme",
  "bugs": {
    "url": "https://github.com/PhantomPixelDev/BetterWebSearch-MCP/issues"
  },
  "author": "PhantomPixelDev <ledbussiness1420@gmail.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "postinstall": "node scripts/check-native.mjs || true",
    "prepublishOnly": "npm run lint && npm test",
    "prepack": "npm run build",
    "postpack": "npm run build",
    "version:patch": "npm version patch -m \"chore(release): %s\"",
    "version:minor": "npm version minor -m \"chore(release): %s\"",
    "version:major": "npm version major -m \"chore(release): %s\"",
    "release:patch": "npm run version:patch && npm publish && git push --follow-tags",
    "release:minor": "npm run version:minor && npm publish && git push --follow-tags",
    "release:major": "npm run version:major && npm publish && git push --follow-tags",
    "check:publish": "npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "web-extraction",
    "ai",
    "search",
    "playwright",
    "readability",
    "claude",
    "opencode",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0",
    "@mozilla/readability": "^0.5.0",
    "better-sqlite3": "^11.0.0",
    "cheerio": "^1.0.0",
    "duck-duck-scrape": "^2.2.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.48.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/jsdom": "^21.0.0",
    "@types/turndown": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
