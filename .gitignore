# Internal planning / evidence (not shipped, not tracked)
.omo/

# Dependencies
node_modules/

# Build output
dist/

# Environment / secrets
.env
.env.local
.env.*.local

# Cache database. Anchored: an unanchored `data/` also matched site/data/,
# which is Hugo's data directory and must be tracked.
/data/

# Logs
*.log
stderr_*.txt

# Benchmark page corpus: multi-megabyte scraped third-party content, and
# regenerable with `npm run bench:corpus -- fetch`. Result summaries are
# committed; the raw pages are not.
benchmarks/results/corpus.json
npm-debug.log*

# Hugo build output
site/public/
site/resources/
.hugo_build.lock

# OS / editor
.DS_Store
Thumbs.db

# Local preview config for the docs site; `npm run docs:serve` is the
# documented way in.
.claude/
